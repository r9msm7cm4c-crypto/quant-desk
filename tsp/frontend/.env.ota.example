# OTA 构建期变量（复制为 .env.local 后按需修改）
# 注意：清单真实位置在仓库的 tsp/ota/ 下，路径缺少 tsp/ 会导致 404。

VITE_OTA_MANIFEST_URL=https://raw.githubusercontent.com/r9msm7cm4c-crypto/quant-desk/main/tsp/ota/stable.json

# 仅当原生构建已把 RSA 公钥注入 capacitor.config.ts 时才置为 true。
# 置为 true 而原生侧缺公钥时，capacitor.config.ts 会直接抛错终止构建。
VITE_OTA_PUBLIC_KEY_CONFIGURED=false

# App 内置的 Web 内容基线版本，用于判断是否已有更新的 bundle。
VITE_OTA_BUNDLED_VERSION=0.1.0
